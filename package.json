{
  "name": "threefold",
  "version": "0.7.0",
  "description": "Threefold — a local desktop app for Claude, ChatGPT and Gemini that runs on your own API keys and shows what every message costs.",
  "main": "./out/main/index.js",
  "author": "nimeshbuilds",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "pnpm typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "release:zip": "pnpm dist && node scripts/release.mjs",
    "dist:dmg": "electron-vite build && electron-builder --mac dmg",
    "postinstall": "node node_modules/electron/install.js",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "demo": "electron-vite build && THREEFOLD_DEMO=1 THREEFOLD_DATA_DIR=.demo-data electron .",
    "test:live": "vitest run --config vitest.live.config.ts",
    "skill": "node scripts/make-skill.mjs",
    "test:subscription": "electron-vite build && node tests/live/subscription-real.mjs",
    "test:link": "pnpm dist && node tests/live/handoff-link.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "highlight.js": "^11.12.0",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/nimeshbuilds/threefold",
  "build": {
    "appId": "dev.nimeshbuilds.threefold",
    "productName": "Threefold",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "protocols": [
      {
        "name": "Threefold handoff",
        "schemes": [
          "threefold"
        ],
        "role": "Viewer"
      }
    ]
  }
}
